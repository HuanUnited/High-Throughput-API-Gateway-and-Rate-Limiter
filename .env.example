# =============================================================================
# Gateway Application
# =============================================================================

# Application settings
APP_NAME=gateway
PORT=8080
LOG_LEVEL=info
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gateway
DB_SSLMODE=disable

# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Rate limiter backend: 'memory' for in-memory (single instance) 
#                     or 'redis' for distributed rate limiting
RATE_LIMIT_BACKEND=redis

# Rate limiting parameters
RATE_LIMIT_TOKENS_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=100
RATE_LIMIT_CLEANUP_INTERVAL=5m

# -----------------------------------------------------------------------------
# Redis Configuration (for distributed rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0

# Redis connection pool
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE=2

# Redis timeouts
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Key prefix to avoid collisions in shared Redis instances
REDIS_KEY_PREFIX=ratelimit:

# -----------------------------------------------------------------------------
# Prometheus Configuration
# -----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# Docker Compose Specific Settings
# =============================================================================

# Container settings (used in docker-compose.yml)
REDIS_VERSION=7.2-alpine
POSTGRES_VERSION=16-alpine
PROMETHEUS_VERSION=v2.47.2
GRAFANA_VERSION=10.2.3

# Network name
DOCKER_NETWORK=gateway-net